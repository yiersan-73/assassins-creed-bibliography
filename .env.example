# Copy this file to .env and fill in your own credentials. NEVER commit .env!

# LLM Provider: "openai" (works with OpenAI, DeepSeek, Gemini, Qwen, OpenRouter, Ollama...) or "anthropic"
LLM_PROVIDER=openai
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.4-mini

# Examples for latest verified models (or use gpt-5.4-nano for ultra-low-cost OpenAI classification):
# DeepSeek:   LLM_PROVIDER=openai    | LLM_BASE_URL=https://api.deepseek.com/v1                              | LLM_MODEL=deepseek-flash
# Gemini:     LLM_PROVIDER=openai    | LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai | LLM_MODEL=gemini-3-flash
# Ollama:     LLM_PROVIDER=openai    | LLM_BASE_URL=http://localhost:11434/v1 | LLM_API_KEY=ollama           | LLM_MODEL=qwen3:14b
# Anthropic:  LLM_PROVIDER=anthropic | LLM_BASE_URL=                                                         | LLM_MODEL=claude-haiku-5-5

ZOTERO_USER_ID=your_zotero_user_or_group_id_here
ZOTERO_LIBRARY_TYPE=user
ZOTERO_API_KEY=your_zotero_api_key_here
ZOTERO_ROOT_COLLECTION_KEY=your_root_collection_key_here
OPENALEX_API_KEY=your_openalex_api_key_here
USER_EMAIL=your_email@example.com
